VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Supabase (articles portal) — client + build scripts
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Cloudflare Turnstile (comment spam protection)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Server-only (Vercel functions; never expose with VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
COMMENT_IP_SALT=any_random_string