VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Supabase (articles portal) — client + build scripts
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Cloudflare Turnstile (comment spam protection)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Server-only (Vercel functions; never expose with VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Base URL used in portal invite emails' redirect (falls back to the request origin if unset).
PORTAL_BASE_URL=https://klepka.solutions
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
COMMENT_IP_SALT=any_random_string

# Google Drive integration (Vercel functions; server-only)
# The org policy blocks service-account keys, so the app acts as a Workspace user via an
# OAuth refresh token. Mint it once with: node scripts/google-refresh-token.mjs
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
# Folder id of the "Klepka Clients" Shared Drive (or a folder inside it)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_shared_drive_folder_id