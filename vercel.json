{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/((?!api/|robots\.txt|sitemap\.xml|favicon\.png|og-image\.png).*)",
      "dest": "/index.html"
    }
  ]
}
